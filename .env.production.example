# Production template — copy to .env on the server and fill the secrets.
# Example topology: SPA on https://leads.miraldrive.com, API on https://api.miraldrive.com

APP_NAME="MiralDrive Lead Qualification"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.miraldrive.com
FRONTEND_URL=https://leads.miraldrive.com
APP_TIMEZONE=UTC
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

# Used once by `php artisan db:seed --class=AdminSeeder` — remove afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=MiralDrive

NRP_MAX_ATTEMPTS=3
NRP_MIN_INTERVAL_MINUTES=30
LEADS_IMPORT_TIMEZONE=Africa/Tunis
LEADS_DEFAULT_COUNTRY_CODE=216

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lead
DB_USERNAME=
DB_PASSWORD=

# Session cookie shared by api. and leads. sub-domains (Sanctum SPA auth)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.miraldrive.com
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=leads.miraldrive.com
CORS_ALLOWED_ORIGINS=https://leads.miraldrive.com
# Comma-separated proxy IPs when behind a load balancer (or * for all)
TRUSTED_PROXIES=

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log
